# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
.vite/
*.tsbuildinfo

# Electron Forge
.webpack/
apps/desktop/out/

# Test / coverage
coverage/

# Local runtime data — user data, credentials, and secrets must never be tracked.
# See docs/dev-rules/credentials-and-local-storage.md.
*.local
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# Stray build output that lands at the repo root (bundled/hashed chunks).
# The real build goes to the ignored dirs above; these are not source.
/index.mjs
/main.js
/*-[A-Za-z0-9_]*.js
/providerDiscovery-*.js
/model-*.js

# Local agent/skill tooling — not part of the app source.
.claude/
.agents/
skills-lock.json
